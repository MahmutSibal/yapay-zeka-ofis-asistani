    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"metin\": {\n      \"type\": \"string\",\n      \"description\": \"Paylaşım metni (hashtag içermez)\"\n    },\n    \"hashtagler\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 0,\n      \"maxItems\": 5\n    },\n    \"gorsel_istemi\": {\n      \"type\": \"string\",\n      \"description\": \"Görsel üretimi için Türkçe tarif\"\n    }\n  },\n  \"required\": [\n    \"metin\",\n    \"hashtagler\",\n    \"gorsel_istemi\"\n  ],\n  \"additionalProperties\": false\n}",
        "autoFix": true
      },
      "id": "ecc8d52f-3c92-4e04-a005-78c12dcf414c",
      "name": "JSON Şeması: İçerik Yaz",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1360,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Qwen modelleri bazen Türkçe harfleri GBK \"mojibake\" karakterleriyle yazar (ı -> 谋, ş -> 艧 ...).\nconst MOJIBAKE = { '莽': 'ç', '脟': 'Ç', '臒': 'ğ', '臑': 'Ğ', '谋': 'ı', '陌': 'İ', '枚': 'ö', '脰': 'Ö', '艧': 'ş', '艦': 'Ş', '眉': 'ü', '脺': 'Ü', '芒': 'â', '卯': 'î', '没': 'û' };\nconst MOJIBAKE_RE = new RegExp('[' + Object.keys(MOJIBAKE).join('') + ']', 'g');\n/** Model metnini temizler: mojibake düzeltme, ** kaldırma, boşluk sadeleştirme */\nconst duzelt = (s) =>\n  String(s ?? '')\n    .replace(MOJIBAKE_RE, (c) => MOJIBAKE[c])\n    .replace(/\\*\\*/g, '')\n    .replace(/[ \\t]+/g, ' ')\n    .trim();\n\n/** Telegram HTML ve e-posta gövdesi için kaçış */\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst b = $('Taslak Bağlamı').itemMatching(0).json;\nconst o = $input.first().json.output || {};\nconst sinir = b.platform === 'x' ? 280 : 3000;\n\nconst hashtagler = [\n  ...new Set(\n    (Array.isArray(o.hashtagler) ? o.hashtagler : [])\n      .map((h) => '#' + duzelt(h).replace(/^#+/, '').replace(/\\s+/g, ''))\n      .filter((h) => h.length > 2),\n  ),\n].slice(0, 5);\nlet metin = duzelt(o.metin).replace(/(^|\\s)#[\\p{L}\\p{N}_]+/gu, '$1').replace(/ {2,}/g, ' ').trim();\nconst ek = hashtagler.length ? '\\n\\n' + hashtagler.join(' ') : '';\nif (metin.length + ek.length > sinir) metin = metin.slice(0, sinir - ek.length - 1).replace(/\\s+\\S*$/, '') + '…';\nif (!metin) throw new Error('Model boş içerik üretti.');\nconst gorsel_istemi = duzelt(o.gorsel_istemi);\nconst simdi = new Date().toISOString();\n\nconst gecmis = [...(b.gecmis || []), { tur: b.tur, metin, hashtagler, tarih: simdi, karar: null, geri_bildirim: null }];\nconst tg = [\n  '📝 <b>Onay bekleyen paylaşım</b> (tur ' + b.tur + '/3, ' + b.platform + ')',\n  '<b>Konu:</b> ' + esc(b.konu),\n  '',\n  esc(metin + ek).slice(0, 3500),\n  '',\n  '👉 Mobil uygulamada <b>İçerik Onayı</b> ekranından onayla ya da geri bildirimle reddet. Onay gelmeden hiçbir şey yayınlanmaz.',\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      kid: b.kid,\n      konu: b.konu,\n      platform: b.platform,\n      tur: b.tur,\n      metin,\n      hashtagler,\n      gorsel_istemi,\n      paylasim_metni: metin + ek,\n      gecmis,\n      durum: 'onay_bekliyor',\n      // Wait düğümünün sürdürme adresi; uygulamaya hiçbir zaman gönderilmez (07 projeksiyonda çıkarır)\n      resume_url: $execution.resumeUrl,\n      guncelleme: simdi,\n      tg_metin: tg,\n    },\n  },\n];"
      },
