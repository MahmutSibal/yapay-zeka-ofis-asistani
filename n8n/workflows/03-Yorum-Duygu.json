    {
      "parameters": {
        "promptType": "define",
        "text": "=Müşteri yorumu:\n\"\"\"\n{{ $json.metin }}\n\"\"\"\n\nBu yorum olumsuz olarak sınıflandırıldı. Ekibin hızlıca anlaması için gerekçeyi ve şikâyet konusunu yaz.",
        "hasOutputParser": true,
