    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"gerekce\": {\n      \"type\": \"string\",\n      \"description\": \"Yorumun neden olumsuz olduğunu anlatan tek cümle\"\n    },\n    \"konu\": {\n      \"type\": \"string\",\n      \"description\": \"Şikâyetin konusu: ör. teslimat, ürün kalitesi, fiyat, personel, iade\"\n    }\n  },\n  \"required\": [\n    \"gerekce\",\n    \"konu\"\n  ],\n  \"additionalProperties\": false\n}",
        "autoFix": true
      },
      "id": "33afef68-8f8e-4cdc-a7a8-fc6db1d1dd1f",
      "name": "JSON Şeması: Gerekçe",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1760,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "// Qwen modelleri bazen Türkçe harfleri GBK \"mojibake\" karakterleriyle yazar (ı -> 谋, ş -> 艧 ...).\nconst MOJIBAKE = { '莽': 'ç', '脟': 'Ç', '臒': 'ğ', '臑': 'Ğ', '谋': 'ı', '陌': 'İ', '枚': 'ö', '脰': 'Ö', '艧': 'ş', '艦': 'Ş', '眉': 'ü', '脺': 'Ü', '芒': 'â', '卯': 'î', '没': 'û' };\nconst MOJIBAKE_RE = new RegExp('[' + Object.keys(MOJIBAKE).join('') + ']', 'g');\n/** Model metnini temizler: mojibake düzeltme, ** kaldırma, boşluk sadeleştirme */\nconst duzelt = (s) =>\n  String(s ?? '')\n    .replace(MOJIBAKE_RE, (c) => MOJIBAKE[c])\n    .replace(/\\*\\*/g, '')\n    .replace(/[ \\t]+/g, ' ')\n    .trim();\n\n/** Telegram HTML ve e-posta gövdesi için kaçış */\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nreturn $input.all().map((item, i) => {\n  const y = $('Duygu Sınıflandır').itemMatching(i).json;\n  const o = item.json.output || {};\n  const gerekce = duzelt(o.gerekce) || 'Gerekçe üretilemedi.';\n  const konu = duzelt(o.konu) || 'belirtilmedi';\n  const html =\n    '<h3 style=\"color:#b42318\">Olumsuz müşteri yorumu</h3>' +\n    '<p><b>Konu:</b> ' + esc(konu) + '<br><b>Gerekçe:</b> ' + esc(gerekce) + '</p>' +\n    '<blockquote style=\"border-left:4px solid #ddd;padding-left:12px;color:#333\">' + esc(y.metin).replace(/\\n/g, '<br>') + '</blockquote>' +\n    '<p style=\"color:#888;font-size:12px\">Yorum kimliği: ' + esc(y.kid) + '</p>';\n  return {\n    json: {\n      kid: y.kid,\n      duygu: 'olumsuz',\n      gerekce,\n      analiz_durumu: 'tamam',\n      guncelleme: new Date().toISOString(),\n      eposta_konu: 'Olumsuz yorum: ' + konu,\n      eposta_html: html,\n    },\n    pairedItem: { item: i },\n  };\n});"
      },
