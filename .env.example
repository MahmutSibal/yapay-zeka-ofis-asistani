# Bu dosyayı .env olarak kopyala ve doldur:  copy .env.example .env
# .env asla paylaşılmaz / git'e eklenmez.

# ---------- n8n ----------
N8N_VERSION=latest
# Rastgele uzun bir değer üret (ör. PowerShell: [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N"))
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
# Telefondan erişilecekse bilgisayarın LAN IP'si veya tünel adresi (sonda / olsun)
WEBHOOK_URL=http://localhost:5678/

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ofis_asistani

# ---------- Ollama ----------
# Host'ta çalışan Ollama: http://host.docker.internal:11434
# compose --profile ollama ile: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- E-posta alıcıları ----------
# Modül 3: olumsuz yorum bildirimi
EKIP_EPOSTA=ekip@ornek.com
# Modül 4: bülten alıcıları (virgülle)
BULTEN_ALICILAR=ben@ornek.com

# ---------- Modül 4: Bülten ----------
BULTEN_KONUSU=yapay zekâ
# Virgülle ayrılmış RSS adresleri
RSS_KAYNAKLARI=https://www.technologyreview.com/topic/artificial-intelligence/feed,https://huggingface.co/blog/feed.xml,https://webrazzi.com/kategori/yapay-zeka/feed/

# ---------- Modül 5: Trello ----------
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_LIST_ID=

# ---------- Google OAuth (Gmail + Drive) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Yetkili yönlendirme URI'si: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Modül 6: LinkedIn ----------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Kişi kimliği: urn:li:person:XXXX ifadesindeki yalnızca XXXX kısmı (rehberde nasıl bulunacağı yazıyor)
LINKEDIN_PERSON=
# Onay için beklenecek en uzun süre (saat); dolunca konu sıraya geri döner
ICERIK_ONAY_SURESI_SAAT=24
# İsteğe bağlı görsel üretim servisi: {"prompt": "..."} POST alıp PNG/JPEG baytları döndürmeli
GORSEL_API_URL=
